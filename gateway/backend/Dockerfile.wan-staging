FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN apt-get update -qq && apt-get install -y -qq --no-install-recommends ffmpeg ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements.wan-staging.txt ./
RUN pip install --no-cache-dir -r requirements.wan-staging.txt \
    && pip install --no-cache-dir "numpy==1.26.4" "opencv-python-headless==4.10.0.84"
# Version-pinned OpenCV Zoo YuNet & SFace quantized weights, checksummed at
# build; no download of sensitive media nor licensed paid model at runtime.
# Source LICENSE files in OpenCV Zoo are Apache 2.0. Do not promise
# rights beyond documented upstream model weights/training-data provenance.
RUN mkdir -p /app/face-models \
    && curl -fsSL --retry 2 --max-time 120 \
       -o /app/face-models/face_detection_yunet_2023mar.onnx \
       "https://huggingface.co/opencv/opencv_zoo/resolve/d4938dfc9d4ec5d098bfa33e98b3f3345a236586/models/face_detection_yunet/face_detection_yunet_2023mar.onnx" \
    && curl -fsSL --retry 2 --max-time 180 \
       -o /app/face-models/face_recognition_sface_2021dec_int8.onnx \
       "https://huggingface.co/opencv/opencv_zoo/resolve/d4938dfc9d4ec5d098bfa33e98b3f3345a236586/models/face_recognition_sface/face_recognition_sface_2021dec_int8.onnx" \
    && echo "8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4  /app/face-models/face_detection_yunet_2023mar.onnx" | sha256sum --check --status \
    && echo "2b0e941e6f16cc048c20aee0c8e31f569118f65d702914540f7bfdc14048d78a  /app/face-models/face_recognition_sface_2021dec_int8.onnx" | sha256sum --check --status
COPY staging_wan_api.py experimental_zerogpu_adapter.py visual_quality.py audio_evidence.py creative_intent_guard.py cpu_photo_studio.py guest_sessions.py procedural_sfx.py compute_supervisor.py ai_trial_guards.py longform_av.py experimental_ltx25_native_av.py experimental_scene_builder_v433.py scene_integrity_v433.py identity_guard_v435.py ./
RUN mkdir -p /app/work && chmod 700 /app/work
ENV KOLBO_V416_WORK_DIR=/app/work KOLBO_LOCAL_FACE_MODELS_DIR=/app/face-models
EXPOSE 10000
CMD ["sh","-c","exec uvicorn staging_wan_api:app --host 0.0.0.0 --port ${PORT:-10000} --workers 1"]

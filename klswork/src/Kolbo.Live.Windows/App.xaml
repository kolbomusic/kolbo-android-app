<Application x:Class="Kolbo.Live.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#0B1220"/><SolidColorBrush x:Key="Panel" Color="#121C30"/><SolidColorBrush x:Key="Line" Color="#293A5C"/>
    <SolidColorBrush x:Key="Text" Color="#F4F7FF"/><SolidColorBrush x:Key="Muted" Color="#9CAAC7"/><SolidColorBrush x:Key="Accent" Color="#9B7CFF"/><SolidColorBrush x:Key="Cyan" Color="#35D7C5"/><SolidColorBrush x:Key="Record" Color="#FF5F79"/>
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="FontFamily" Value="Segoe UI"/></Style>
    <Style TargetType="Button"><Setter Property="Foreground" Value="{StaticResource Text}"/><Setter Property="Background" Value="{StaticResource Panel}"/><Setter Property="BorderBrush" Value="{StaticResource Line}"/><Setter Property="Padding" Value="16,10"/><Setter Property="Margin" Value="4"/></Style>
  </Application.Resources>
</Application>

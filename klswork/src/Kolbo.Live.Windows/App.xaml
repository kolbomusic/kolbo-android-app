<Application x:Class="Kolbo.Live.Windows.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="Bg" Color="#08111F"/>
    <SolidColorBrush x:Key="Panel" Color="#111D31"/>
    <SolidColorBrush x:Key="Panel2" Color="#17253D"/>
    <SolidColorBrush x:Key="Line" Color="#486080"/>
    <SolidColorBrush x:Key="Text" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Muted" Color="#D8E2F2"/>
    <SolidColorBrush x:Key="Accent" Color="#8F6CFF"/>
    <SolidColorBrush x:Key="Cyan" Color="#35D7C5"/>
    <SolidColorBrush x:Key="Record" Color="#FF5F79"/>
    <SolidColorBrush x:Key="InputBg" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="InputText" Color="#111827"/>

    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="15"/>
    </Style>

    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Panel2}"/>
      <Setter Property="BorderBrush" Value="#60769A"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="Margin" Value="4"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="40"/>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{StaticResource InputText}"/>
      <Setter Property="Background" Value="{StaticResource InputBg}"/>
      <Setter Property="BorderBrush" Value="#7388AA"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{StaticResource InputText}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="10,7"/>
      <Setter Property="MinHeight" Value="36"/>
      <Style.Triggers>
        <Trigger Property="IsSelected" Value="True">
          <Setter Property="Background" Value="#DDD6FE"/>
          <Setter Property="Foreground" Value="#111827"/>
        </Trigger>
        <Trigger Property="IsMouseOver" Value="True">
          <Setter Property="Background" Value="#EDE8FF"/>
          <Setter Property="Foreground" Value="#111827"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource InputText}"/>
      <Setter Property="Background" Value="{StaticResource InputBg}"/>
      <Setter Property="BorderBrush" Value="#7388AA"/>
      <Setter Property="BorderThickness" Value="1.5"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Padding" Value="8,4"/>
      <Setter Property="MinHeight" Value="38"/>
    </Style>

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="Margin" Value="0,4,0,12"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
    </Style>

    <Style TargetType="Slider">
      <Setter Property="MinHeight" Value="28"/>
    </Style>

    <Style TargetType="ProgressBar">
      <Setter Property="Background" Value="#263650"/>
      <Setter Property="BorderBrush" Value="#60769A"/>
    </Style>
  </Application.Resources>
</Application>

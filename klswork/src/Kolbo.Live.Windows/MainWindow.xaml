<Window x:Class="Kolbo.Live.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kolbo Live Studio — Preview 0.1.9"
        Width="1180" Height="700" MinWidth="860" MinHeight="560"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResizeWithGrip" WindowState="Normal"
        Background="{StaticResource Bg}" FlowDirection="RightToLeft"
        WindowStartupLocation="CenterScreen">

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="34"/>
    </Grid.RowDefinitions>

    <Grid Grid.Row="0" Margin="14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="1.05*"/>
        <ColumnDefinition Width="1.45*"/>
      </Grid.ColumnDefinitions>

      <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,12,0">
        <StackPanel>
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="18" Margin="0,0,0,10">
            <StackPanel>
              <TextBlock Text="כרטיס וניתוב ASIO" FontSize="21" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBlock Text="כרטיס קול" Foreground="{StaticResource Muted}"/>
              <ComboBox x:Name="DeviceBox" Margin="0,5,0,8" SelectionChanged="DeviceBox_SelectionChanged"/>

              <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Button Content="בדיקת ASIO ומיפוי" Click="Probe_Click"/>
                <Button Content="פתח לוח בקרה ASIO" Click="AsioControlPanel_Click"/>
              </StackPanel>

              <TextBlock Text="קצב דגימה" Foreground="{StaticResource Muted}"/>
              <ComboBox x:Name="RateBox" Margin="0,5,0,10">
                <ComboBoxItem Content="44100 Hz"/>
                <ComboBoxItem Content="48000 Hz" IsSelected="True"/>
                <ComboBoxItem Content="88200 Hz"/>
                <ComboBoxItem Content="96000 Hz"/>
                <ComboBoxItem Content="192000 Hz"/>
              </ComboBox>

              <Border Background="#17253D" BorderBrush="#486080" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,2,0,10">
                <StackPanel>
                  <TextBlock Text="פרופיל חומרה" FontWeight="SemiBold"/>
                  <TextBlock x:Name="HardwareProfileText" Text="טרם בוצעה בדיקת ASIO" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
              </Border>

              <CheckBox x:Name="WetOnlyConfirm">
                <TextBlock Text="לניטור זהה להקלטה: Direct Monitor כבוי בכרטיס. ה־Master של התוכנה הוא מה ששומעים ומה שנשמר."
                           TextWrapping="Wrap" Foreground="White"/>
              </CheckBox>

              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="132"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Dry Input" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox Grid.Row="0" Grid.Column="1" x:Name="DryBox" Margin="0,3"/>
                <TextBlock Grid.Row="1" Text="REV-X Return L" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox Grid.Row="1" Grid.Column="1" x:Name="WetLBox" Margin="0,3"/>
                <TextBlock Grid.Row="2" Text="REV-X Return R" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox Grid.Row="2" Grid.Column="1" x:Name="WetRBox" Margin="0,3"/>
                <TextBlock Grid.Row="3" Text="REV-X Send L" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox Grid.Row="3" Grid.Column="1" x:Name="SendLBox" Margin="0,3"/>
                <TextBlock Grid.Row="4" Text="REV-X Send R" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox Grid.Row="4" Grid.Column="1" x:Name="SendRBox" Margin="0,3"/>
                <TextBlock Grid.Row="5" Text="Monitor L" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox Grid.Row="5" Grid.Column="1" x:Name="MasterLBox" Margin="0,3"/>
                <TextBlock Grid.Row="6" Text="Monitor R" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox Grid.Row="6" Grid.Column="1" x:Name="MasterRBox" Margin="0,3"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="18">
            <StackPanel>
              <TextBlock Text="מיקס חי והקלטה" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,12"/>
              <TextBlock Text="Dry להקלטה" Foreground="{StaticResource Muted}"/><Slider x:Name="DryGain" Minimum="0" Maximum="150" Value="100"/>
              <TextBlock Text="REV-X Wet" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><Slider x:Name="WetGain" Minimum="0" Maximum="150" Value="100"/>
              <TextBlock Text="Playback" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><Slider x:Name="BackingGain" Minimum="0" Maximum="150" Value="70"/>
              <TextBlock Text="REV-X Send" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/><Slider x:Name="SendGain" Minimum="0" Maximum="150" Value="100"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>

      <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16" Padding="22">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

          <DockPanel Grid.Row="0">
            <StackPanel DockPanel.Dock="Right">
              <TextBlock Text="הופעה חדשה" FontSize="26" FontWeight="Bold"/>
              <TextBlock Text="MR816X: Dry + REV-X Return + Playback עוברים דרך אותו Master — מה ששומעים הוא מה שנשמר" Foreground="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Left" Background="#17253D" CornerRadius="16" Padding="12,7">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="StateDot" Width="10" Height="10" Fill="#35D7C5" Margin="0,0,8,0"/>
                <TextBlock x:Name="StateTextBlock" Text="מוכן" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              </StackPanel>
            </Border>
          </DockPanel>

          <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel VerticalAlignment="Center">
            <TextBlock Text="בחר מקור פלייבק ובדוק את REV-X לפני ההקלטה" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
            <TextBlock Text="אפשר לבחור אודיו, סרטון קריוקי מהמחשב או קישור YouTube. בסרטון הווידאו מוצג כאן והאודיו נכנס דרך ASIO." Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,8,0,14" TextWrapping="Wrap" TextAlignment="Center"/>

            <Border Background="#0D1729" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16">
              <StackPanel>
                <TextBlock x:Name="BackingText" Text="אין מקור פלייבק שנבחר" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,8" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                  <Button Content="בחר אודיו / סרטון קריוקי" Click="ChooseBacking_Click"/>
                </StackPanel>
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                  <TextBox x:Name="YouTubeUrlBox" Grid.Column="0" FlowDirection="LeftToRight" TextAlignment="Left" ToolTip="הדבק קישור YouTube"/>
                  <Button Grid.Column="1" Content="טען YouTube" Click="LoadYouTube_Click" Margin="8,0,0,0"/>
                </Grid>
                <TextBlock x:Name="MediaStatusText" Text="בחר מקור. בקישור YouTube השתמש בתוכן שמותר לך לנגן ולהוריד." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0"/>
                <Border x:Name="KaraokeVideoFrame" Visibility="Collapsed" Background="Black" BorderBrush="#486080" BorderThickness="1" CornerRadius="10" Margin="0,12,0,0" Height="230">
                  <MediaElement x:Name="KaraokeVideoPlayer" LoadedBehavior="Manual" UnloadedBehavior="Manual" IsMuted="True" Stretch="Uniform" ScrubbingEnabled="True"/>
                </Border>
              </StackPanel>
            </Border>

            <Border Background="#17253D" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Ellipse x:Name="EffectStatusDot" Width="14" Height="14" Fill="#F4B942" Margin="0,2,12,0" VerticalAlignment="Top"/>
                <StackPanel Grid.Column="1">
                  <TextBlock Text="אימות אפקט בחומרה" FontSize="18" FontWeight="SemiBold"/>
                  <TextBlock x:Name="EffectStatusText" Text="לא נבדק עדיין. בזמן הקלטה התוכנה תוודא שמגיע אות REV-X אמיתי בערוצי ה־Wet." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0"/>
                </StackPanel>
              </Grid>
            </Border>

            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Margin="0,0,8,0">
                <TextBlock Text="Dry Input" Foreground="{StaticResource Muted}"/>
                <ProgressBar x:Name="DryMeter" Minimum="0" Maximum="1" Height="14" Margin="0,5,0,8" Foreground="{StaticResource Accent}"/>
              </StackPanel>
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="REV-X Wet Return" Foreground="{StaticResource Muted}"/>
                <ProgressBar x:Name="WetMeter" Minimum="0" Maximum="1" Height="14" Margin="0,5,0,8" Foreground="{StaticResource Cyan}"/>
              </StackPanel>
            </Grid>

            <TextBlock x:Name="ElapsedText" Text="00:00:00" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,4,0,6"/>
            <TextBlock x:Name="InfoText" Text="מוכן. לחץ על בדיקת ASIO ומיפוי." Foreground="{StaticResource Muted}" TextWrapping="Wrap" TextAlignment="Center"/>
          </StackPanel>
          </ScrollViewer>

          <StackPanel Grid.Row="2">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
              <Button Content="חבר טלפון למצלמה" Click="PairPhone_Click"/>
              <Button Content="●  התחל הקלטה" Background="{StaticResource Record}" FontSize="17" Padding="26,12" Click="Record_Click"/>
              <Button Content="עצור ושמור" Click="Stop_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
              <Button Content="ייצא אודיו (WAV + MP3)" Click="ExportAudio_Click"/>
              <Button Content="ייצא וידאו (אופציונלי)" Click="ExportVideo_Click"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
              <TextBlock Text="Video Offset:" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
              <TextBox x:Name="VideoOffsetBox" Text="0.000" Width="90" Margin="8,0,0,0" FlowDirection="LeftToRight"/>
            </StackPanel>
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="1" Background="#0E192B" BorderBrush="#334866" BorderThickness="0,1,0,0">
      <TextBlock Text="Preview 0.1.9 • אודיו / סרטון קריוקי / YouTube • ההקלטות נשמרות בנפרד ואינן נמחקות בהסרה"
                 Foreground="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13"/>
    </Border>
  </Grid>
</Window>

<Window x:Class="Kolbo.Live.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Kolbo Live Studio" Width="1360" Height="900" MinWidth="1080" MinHeight="720"
        Background="{StaticResource Bg}" FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="0,0,0,20">
      <StackPanel DockPanel.Dock="Right">
        <TextBlock Text="KOLBO LIVE STUDIO" FontSize="26" FontWeight="Bold"/>
        <TextBlock Text="Preview 0.1.5 • ASIO duplex • החזרת אפקטים אמיתית מהכרטיס" Foreground="{StaticResource Muted}" FontSize="14" Margin="0,4,0,0"/>
      </StackPanel>
      <Border DockPanel.Dock="Left" Background="#16233B" CornerRadius="18" Padding="14,8">
        <StackPanel Orientation="Horizontal"><Ellipse x:Name="StateDot" Width="10" Height="10" Fill="#35D7C5" Margin="0,0,8,0"/><TextBlock x:Name="StateTextBlock" Text="מוכן" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel>
      </Border>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.55*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="20" Padding="24" Margin="0,0,14,0">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel>
            <TextBlock Text="הופעה חדשה" FontSize="22" FontWeight="SemiBold"/>
            <Button DockPanel.Dock="Left" Content="חבר טלפון למצלמה" Click="PairPhone_Click"/>
          </DockPanel>
          <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <TextBlock Text="הכן את המערכת" FontSize="30" FontWeight="SemiBold" HorizontalAlignment="Center"/>
            <TextBlock Text="בחר פלייבק, בצע בדיקת ASIO ואשר את מיפוי ה־Dry / Wet / Send / Master" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,10,0,28"/>
            <Border Height="160" Background="#0D1729" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14">
              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock x:Name="BackingText" Text="אין פלייבק שנבחר" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="14" TextWrapping="Wrap"/>
                <Button Content="בחר קובץ פלייבק" Click="ChooseBacking_Click"/>
              </StackPanel>
            </Border>
            <Border Background="#101C31" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="14" Padding="18" Margin="0,20,0,0">
              <StackPanel>
                <TextBlock Text="עיקרון ההקלטה" FontWeight="SemiBold" FontSize="17"/>
                <TextBlock Text="Dry → FX Send בלבד • Wet Return → Master • Playback → Master • אותו Master נשלח למוניטור ונשמר ללא שחזור בדיעבד." Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="בדיקת ASIO ומיפוי" Click="Probe_Click"/>
            <Button Content="●  התחל הקלטה" Background="{StaticResource Record}" FontSize="16" Padding="28,14" Click="Record_Click"/>
            <Button Content="עצור ושמור" Click="Stop_Click"/><Button Content="ייצא MP4" Click="Export_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="20" Padding="20" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="כרטיס וניתוב ASIO" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
              <TextBlock Text="כרטיס קול" Foreground="{StaticResource Muted}"/><ComboBox x:Name="DeviceBox" Margin="0,5,0,8" Height="34" SelectionChanged="DeviceBox_SelectionChanged"/>
              <Button Content="פתח לוח בקרה ASIO" Click="AsioControlPanel_Click" HorizontalAlignment="Left" Margin="0,0,0,10"/>
              <TextBlock Text="קצב דגימה" Foreground="{StaticResource Muted}"/>
              <ComboBox x:Name="RateBox" Margin="0,5,0,12" Height="34"><ComboBoxItem Content="44100 Hz"/><ComboBoxItem Content="48000 Hz" IsSelected="True"/><ComboBoxItem Content="88200 Hz"/><ComboBoxItem Content="96000 Hz"/><ComboBoxItem Content="192000 Hz"/></ComboBox>
              <CheckBox x:Name="WetOnlyConfirm" Content="אני מאשר שה־Wet Return הוא אפקט בלבד ושאין Direct Monitor כפול" Foreground="{StaticResource Muted}" Margin="0,0,0,12"/>
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="122"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="Dry Input" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox Grid.Row="0" Grid.Column="1" x:Name="DryBox" Margin="0,3"/>
                <TextBlock Grid.Row="1" Text="Wet L" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox Grid.Row="1" Grid.Column="1" x:Name="WetLBox" Margin="0,3"/>
                <TextBlock Grid.Row="2" Text="Wet R" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox Grid.Row="2" Grid.Column="1" x:Name="WetRBox" Margin="0,3"/>
                <TextBlock Grid.Row="3" Text="FX Send L" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox Grid.Row="3" Grid.Column="1" x:Name="SendLBox" Margin="0,3"/>
                <TextBlock Grid.Row="4" Text="FX Send R" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox Grid.Row="4" Grid.Column="1" x:Name="SendRBox" Margin="0,3"/>
                <TextBlock Grid.Row="5" Text="Master L" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox Grid.Row="5" Grid.Column="1" x:Name="MasterLBox" Margin="0,3"/>
                <TextBlock Grid.Row="6" Text="Master R" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox Grid.Row="6" Grid.Column="1" x:Name="MasterRBox" Margin="0,3"/>
              </Grid>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="20" Padding="20" Margin="0,0,0,12">
            <StackPanel>
              <TextBlock Text="מיקס חי — זהה להקלטה" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
              <TextBlock Text="Dry" Foreground="{StaticResource Muted}"/><Slider x:Name="DryGain" Minimum="0" Maximum="150" Value="100" TickFrequency="5"/>
              <TextBlock Text="Wet" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/><Slider x:Name="WetGain" Minimum="0" Maximum="150" Value="100" TickFrequency="5"/>
              <TextBlock Text="Playback" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/><Slider x:Name="BackingGain" Minimum="0" Maximum="150" Value="70" TickFrequency="5"/>
              <TextBlock Text="FX Send" Foreground="{StaticResource Muted}" Margin="0,7,0,0"/><Slider x:Name="SendGain" Minimum="0" Maximum="150" Value="70" TickFrequency="5"/>
            </StackPanel>
          </Border>

          <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="20" Padding="20">
            <StackPanel>
              <TextBlock Text="מדדים חיים" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
              <TextBlock Text="קול יבש" Foreground="{StaticResource Muted}"/><ProgressBar x:Name="DryMeter" Minimum="0" Maximum="1" Height="10" Margin="0,5,0,10" Foreground="{StaticResource Accent}"/>
              <TextBlock Text="Wet Return" Foreground="{StaticResource Muted}"/><ProgressBar x:Name="WetMeter" Minimum="0" Maximum="1" Height="10" Margin="0,5,0,10" Foreground="{StaticResource Cyan}"/>
              <TextBlock x:Name="ElapsedText" Text="00:00:00" FontSize="20" FontWeight="SemiBold" Margin="0,4,0,6"/><TextBlock Text="Video Offset בשניות (חיובי = הווידאו מאוחר יותר)" Foreground="{StaticResource Muted}"/><TextBox x:Name="VideoOffsetBox" Text="0.000" Height="30" Margin="0,5,0,8"/>
              <TextBlock x:Name="InfoText" Text="מוכן. בצע בדיקת ASIO לפני ההקלטה." Foreground="{StaticResource Muted}" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <TextBlock Grid.Row="2" Text="Preview: נדרשת בדיקת קבלה על Windows, כרטיס הקול והטלפון בפועל. הסרת התוכנה אינה מוחקת הקלטות." Foreground="{StaticResource Muted}" Margin="0,14,0,0" HorizontalAlignment="Center"/>
  </Grid>
</Window>
